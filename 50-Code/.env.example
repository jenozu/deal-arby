# eBay OAuth credentials from the eBay Developer Program application keyset.
# Never commit a real .env file.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Start with sandbox. Switch to production only when the production keyset
# has the required Buy API access.
EBAY_ENVIRONMENT=sandbox

# Canadian marketplace defaults for Deal Arby.
EBAY_MARKETPLACE_ID=EBAY_CA
EBAY_CURRENCY=CAD
EBAY_COUNTRY_CODE=CA
EBAY_POSTAL_CODE=
EBAY_ACCEPT_LANGUAGE=en-CA

EBAY_TIMEOUT_SECONDS=20
EBAY_MAX_RETRIES=3
